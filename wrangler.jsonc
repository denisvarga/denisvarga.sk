{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "denisvarga-sk",
  "account_id": "9236461db74f030db851f864fb7ebb1b",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-02",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "denisvarga.sk", "custom_domain": true },
    { "pattern": "denisvarga.dev", "custom_domain": true }
  ],
  "assets": {
    "not_found_handling": "404-page",
    // Pages stay free static assets: the denisvarga.dev "/" -> "/en/" rewrite and the "/en*"
    // redirects are zone rules in Cloudflare, so only the chat API and the private question
    // overview (behind Cloudflare Access) invoke the Worker.
    "run_worker_first": ["/api/*", "/prehlad", "/prehlad/*"]
  },
  // Daily cleanup of the question log and the per-client counters (worker/scheduled.ts).
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },
  // Created with jurisdiction "eu"; the jurisdiction is fixed at creation, not set here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cv-chat",
      "database_id": "f72a03be-3d21-4eae-9b77-676f494f1e76",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "ASK_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  // Contact messages from the chat go only to this verified Email Routing destination, so the
  // endpoint can never relay mail to anyone else. The sender (CONTACT_FROM) must be on a domain
  // with Email Routing enabled.
  "send_email": [
    {
      "name": "CONTACT_MAIL",
      "destination_address": "hello@denisvarga.sk"
    }
  ],
  "secrets": {
    "required": ["OPENAI_API_KEY", "TURNSTILE_SECRET_KEY", "SAFETY_SALT"]
  },
  "vars": {
    "OPENAI_MODEL": "gpt-6-luna",
    "OPENAI_REASONING_EFFORT": "none",
    "DAILY_CAP": "300",
    // Model calls one client (IPv4 address or IPv6 /64) may use per UTC day, so one visitor cannot
    // spend the whole DAILY_CAP.
    "CLIENT_DAILY_CAP": "20",
    // Days a question stays in chat_log before the daily cron deletes it; under 30 or malformed,
    // the cron logs retention_config_error and deletes nothing. The privacy notice states the same period.
    "CHAT_LOG_RETENTION_DAYS": "365",
    "ALLOWED_ORIGINS": "https://denisvarga.sk,https://denisvarga.dev",
    "TURNSTILE_HOSTNAME": "denisvarga.sk,denisvarga.dev",
    "TURNSTILE_ACTION": "ask",
    // Kill switch for the contact hand-off: while not "true" the model is not offered the tool and
    // /api/contact answers 503 unavailable. Enable only after the Email Routing subdomain, the
    // verified destination and the WAF rule for POST /api/contact are in place.
    "CONTACT_ENABLED": "true",
    "CONTACT_FROM": "web@notify.denisvarga.sk",
    // Must equal destination_address of the CONTACT_MAIL binding.
    "CONTACT_TO": "hello@denisvarga.sk",
    "TURNSTILE_CONTACT_ACTION": "contact",
    // Contact messages per client (IPv4 address or IPv6 /64) and in total per UTC day.
    "CONTACT_CLIENT_DAILY_CAP": "3",
    "CONTACT_DAILY_CAP": "30",
    // Comma-separated emails the Worker admits to /prehlad on top of the Access policy; empty admits
    // every identity the policy lets through.
    "ACCESS_ALLOWED_EMAILS": "",
    // AUD tag of the "denisvarga prehlad" Access application (denisvarga.sk and .dev /prehlad);
    // with an empty value /prehlad answers 404.
    "ACCESS_TEAM_DOMAIN": "https://denva.cloudflareaccess.com",
    "ACCESS_AUD": "b1f48cd087ed7fc17a30400939a7193c6aa2b1e7f649b7031685de3b76aff335"
  }
}
