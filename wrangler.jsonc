{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "denisvarga-sk",
  "account_id": "9236461db74f030db851f864fb7ebb1b",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-02",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "denisvarga.sk", "custom_domain": true }],
  "assets": {
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },
  // Created with jurisdiction "eu"; the jurisdiction is fixed at creation, not set here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cv-chat",
      "database_id": "f72a03be-3d21-4eae-9b77-676f494f1e76",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "ASK_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "secrets": {
    "required": ["OPENAI_API_KEY", "TURNSTILE_SECRET_KEY", "SAFETY_SALT"]
  },
  "vars": {
    "OPENAI_MODEL": "gpt-6-luna",
    "OPENAI_REASONING_EFFORT": "none",
    "DAILY_CAP": "300",
    "ALLOWED_ORIGINS": "https://denisvarga.sk",
    "TURNSTILE_HOSTNAME": "denisvarga.sk",
    "TURNSTILE_ACTION": "ask"
  }
}
