{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "denisvarga-sk",
  "account_id": "9236461db74f030db851f864fb7ebb1b",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-02",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "denisvarga.sk", "custom_domain": true },
    { "pattern": "denisvarga.dev", "custom_domain": true }
  ],
  "assets": {
    "not_found_handling": "404-page",
    // Pages stay free static assets: the denisvarga.dev "/" -> "/en/" rewrite and the "/en*"
    // redirects are zone rules in Cloudflare, so only the chat API and the private question
    // overview (behind Cloudflare Access) invoke the Worker.
    "run_worker_first": ["/api/*", "/prehlad*"]
  },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },
  // Created with jurisdiction "eu"; the jurisdiction is fixed at creation, not set here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cv-chat",
      "database_id": "f72a03be-3d21-4eae-9b77-676f494f1e76",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "ASK_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "secrets": {
    "required": ["OPENAI_API_KEY", "TURNSTILE_SECRET_KEY", "SAFETY_SALT"]
  },
  "vars": {
    "OPENAI_MODEL": "gpt-6-luna",
    "OPENAI_REASONING_EFFORT": "none",
    "DAILY_CAP": "300",
    "ALLOWED_ORIGINS": "https://denisvarga.sk,https://denisvarga.dev",
    "TURNSTILE_HOSTNAME": "denisvarga.sk,denisvarga.dev",
    "TURNSTILE_ACTION": "ask",
    // AUD tag of the "denisvarga prehlad" Access application (denisvarga.sk and .dev /prehlad);
    // with an empty value /prehlad answers 404.
    "ACCESS_TEAM_DOMAIN": "https://denva.cloudflareaccess.com",
    "ACCESS_AUD": "b1f48cd087ed7fc17a30400939a7193c6aa2b1e7f649b7031685de3b76aff335"
  }
}
