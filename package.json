{
  "name": "denisvarga-sk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsx scripts/prerender.ts && tsx scripts/check-dist.ts",
    "build:deploy": "vite build --mode deploy && rm -f dist/*/.dev.vars* && tsx scripts/prerender.ts && tsx scripts/check-dist.ts --deploy",
    "deploy": "pnpm run build:deploy && wrangler deploy",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "audit": "pnpm audit --prod --audit-level high",
    "ci:local": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm audit",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --strict-vars=false",
    "images:fetch": "tsx scripts/fetch-project-images.ts",
    "images": "tsx scripts/build-images.ts",
    "og": "tsx scripts/build-og-image.ts",
    "ascii": "tsx scripts/build-ascii-portrait.ts",
    "cv": "pnpm build && tsx scripts/build-cv-pdf.ts",
    "icons": "tsx scripts/build-icons.ts",
    "db:migrate:local": "wrangler d1 migrations apply cv-chat --local",
    "db:migrate:remote": "wrangler d1 migrations apply cv-chat --remote",
    "logs:recent": "wrangler d1 execute cv-chat --remote --command \"SELECT created_at, lang, outcome, question, answer FROM chat_log ORDER BY created_at DESC LIMIT 50\"",
    "eval": "tsx --env-file=.dev.vars scripts/eval-agent.ts",
    "smoke": "bash scripts/smoke-prod.sh"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@hono/zod-validator": "0.9.1",
    "hono": "4.13.12",
    "lenis": "1.3.26",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.62.3",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "oxlint": "1.86.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.3",
    "wrangler": "4.145.0"
  }
}
